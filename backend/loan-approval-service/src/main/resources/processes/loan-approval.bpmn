<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- تم إضافة camunda:historyTimeToLive="P180D" هنا -->
  <bpmn:process id="loan-approval-process" name="Loan Approval Process" isExecutable="true" camunda:historyTimeToLive="P180D">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Loan Request Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Task: Check Credit Score -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckCredit" />
    <bpmn:serviceTask id="Task_CheckCredit" name="Check Credit Score" camunda:delegateExpression="${checkCreditScoreDelegate}">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Credit Decision -->
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckCredit" targetRef="Gateway_CreditCheck" />
    <bpmn:exclusiveGateway id="Gateway_CreditCheck" name="Approved Automatically?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Flow Automatic Approval -->
    <bpmn:sequenceFlow id="Flow_Approved" name="Score High" sourceRef="Gateway_CreditCheck" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditApproved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- User Task: Manual Review -->
    <bpmn:sequenceFlow id="Flow_ManualReview" name="Score Low" sourceRef="Gateway_CreditCheck" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!creditApproved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="Task_ManualReview" name="Manual Review by Officer" camunda:assignee="admin">
      <bpmn:incoming>Flow_ManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ManualReview" targetRef="EndEvent_Approved" />

    <bpmn:endEvent id="EndEvent_Approved" name="Loan Process Completed">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>